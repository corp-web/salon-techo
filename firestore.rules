rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ログインした本人のデータだけ読み書きできる。それ以外はすべて拒否
    match /users/{uid}/{col}/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid && col != 'backups';
    }
    // 毎日の控え：本人が作る・読むだけ。書き換えは不可、削除は作ってから60日たったものだけ
    // （アプリに不具合があっても、控えは消えない）
    match /users/{uid}/backups/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid && resource.data.at < request.time - duration.value(60, 'd');
    }
  }
}
